# Database (MySQL on Hostinger — separate ec_db)
# Use 127.0.0.1, NOT localhost (localhost resolves to IPv6 ::1, DB grant is IPv4-only)
DATABASE_URL="mysql://ec_user:password@127.0.0.1:3306/ec_db"

# Auth
JWT_SECRET="generate-a-strong-random-secret-here"

# Claude API (voice assistant) — optional, voice features degrade gracefully without it
ANTHROPIC_API_KEY="sk-ant-..."

# Firebase Cloud Messaging — optional, push notifications no-op without it
FCM_PROJECT_ID=""
FCM_PRIVATE_KEY=""
FCM_CLIENT_EMAIL=""

# Resend (password reset emails) — optional; forgot-password requests still succeed
# without it, but no email actually goes out (logged to server console instead).
# Get an API key at resend.com, verify eccare.in as a sending domain there, then set
# EMAIL_FROM to an address on that domain, e.g. "EC <no-reply@eccare.in>".
RESEND_API_KEY=""
EMAIL_FROM="EC <no-reply@eccare.in>"

# Public base URL used to build links in outgoing emails (e.g. password reset).
# Falls back to the request's own origin if unset, but set this explicitly in
# production so links are always https://eccare.in/... regardless of how the
# request reached the server.
APP_URL="https://eccare.in"

NODE_ENV="production"

# NOTE: in production on Hostinger, set these in the Node.js app's Environment
# Variables panel in hPanel — NOT as a .env file in the deployed directory. A .env
# file gets wiped by autodeploy's git sync. See ec-platform skill §7.2.
