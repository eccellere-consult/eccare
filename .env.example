# Database (MySQL on Hostinger — separate ec_db)
# Use 127.0.0.1, NOT localhost (localhost resolves to IPv6 ::1, DB grant is IPv4-only)
DATABASE_URL="mysql://ec_user:password@127.0.0.1:3306/ec_db"

# Auth
JWT_SECRET="generate-a-strong-random-secret-here"

# Claude API (voice assistant) — optional, voice features degrade gracefully without it
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI Whisper (speech-to-text for "Speak to Arya" and voice-based Health Notes) —
# without this, POST /api/v1/voice/transcribe returns a clear "not available" error
# instead of transcribing, so tap-to-speak silently can't turn a recording into text
# or an action. Get a key at platform.openai.com/api-keys.
OPENAI_API_KEY="sk-..."

# Arya's spoken voice — POST /api/v1/voice/speak. Without either option below, Arya falls
# back to the best Indian-English voice the user's own browser offers (quality varies by
# device; some have none). Options, in the order they are tried:
#   1. Azure Neural TTS (recommended — a native Indian-English voice, en-IN-NeerjaNeural):
#      create a "Speech" resource in the Azure portal, then set the key and its region.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="centralindia"
# AZURE_SPEECH_VOICE="en-IN-NeerjaNeural"
#   2. OpenAI gpt-4o-mini-tts steered toward an Indian-English accent — uses the
#      OPENAI_API_KEY above, nothing extra to set. Optional voice override:
# OPENAI_TTS_VOICE="shimmer"

# Arya's face, in order of preference: a photoreal GLB (below), else the photo in
# public/avatars (arya.webp, then arya.png), else the built-in 3D avatar. Only set
# NEXT_PUBLIC_ARYA_PHOTO_URL to load the photo from somewhere else.
# NEXT_PUBLIC_ARYA_PHOTO_URL=""
#
# Optional photoreal Arya: put a rigged avatar at public/models/arya.glb and it is used
# automatically. Only set this to load it from somewhere else (e.g. the R2 bucket).
# See docs/ARYA_PHOTOREAL_AVATAR.md.
# NEXT_PUBLIC_ARYA_MODEL_URL=""

# Health bulletins — an agent that searches trusted health sources (WHO, NHS, NIH, AAO, MoHFW…) and drafts
# short tips for an admin to approve (admin → Health Bulletins). Uses ANTHROPIC_API_KEY above unless its own key is
# set below; web search must be switched on for your organisation in the Anthropic console.
# See docs/HEALTH_BULLETIN_AGENT.md.
# A separate key (ideally in its own Anthropic workspace with its own spending limit) means a limit on one of the
# two features can never switch off the other (the voice assistant also uses ANTHROPIC_API_KEY):
# HEALTH_AGENT_API_KEY="sk-ant-..."
# HEALTH_AGENT_MODEL="claude-sonnet-5-5"
# Weekly automatic drafting: set a long random secret, then have a scheduler call
# POST /api/v1/cron/health-bulletins with "Authorization: Bearer <secret>". It only ever writes DRAFTS.
CRON_SECRET=""

# Cloudflare R2 (S3-compatible object storage) — required for every upload feature:
# Memories, Prescriptions, Health Coverage/Diagnostic Report documents, Community
# documents, Marketplace and Provider Catalog images, Provider certifications.
# Without these, POST to any of those routes returns a clear "not available" error
# instead of silently losing the file.
#
# Why object storage and not local disk: Hostinger's autodeploy checks every push
# out into a brand-new versioned build directory, so anything written to local disk
# (the old approach) was wiped on the very next deploy — this was the actual cause
# of "photo uploaded on mobile isn't visible on web (or vice versa)".
#
# Setup: create a bucket in the Cloudflare dashboard (R2 Object Storage → Create
# bucket), enable public access for it (Settings → allow the r2.dev public URL, or
# connect a custom domain), then create an API token (R2 → Manage R2 API Tokens →
# Create API Token, with read+write permission on this bucket) for the key pair below.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="eccare-uploads"
# No trailing slash — the r2.dev public URL shown on the bucket's Settings page
# (e.g. https://pub-xxxxxxxxxxxx.r2.dev), or a custom domain connected to it.
R2_PUBLIC_URL=""

# Razorpay — payments (community fee charges, marketplace/catalog orders,
# provider featured ads, doctor consultation booking). Was already used across
# the app but never actually documented here until now.
# Get keys at dashboard.razorpay.com → Settings → API Keys. The webhook secret is
# set separately when you register the webhook URL (Settings → Webhooks) —
# needed for POST /api/v1/webhooks/razorpay, not for checkout itself.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Firebase Cloud Messaging — optional, push notifications no-op without it
FCM_PROJECT_ID=""
FCM_PRIVATE_KEY=""
FCM_CLIENT_EMAIL=""

# Resend (password reset emails) — optional; forgot-password requests still succeed
# without it, but no email actually goes out (logged to server console instead).
# Get an API key at resend.com, verify eccare.in as a sending domain there, then set
# EMAIL_FROM to an address on that domain, e.g. "EC <no-reply@eccare.in>".
RESEND_API_KEY=""
EMAIL_FROM="EC <no-reply@eccare.in>"

# Public base URL used to build links in outgoing emails (e.g. password reset).
# Falls back to the request's own origin if unset, but set this explicitly in
# production so links are always https://eccare.in/... regardless of how the
# request reached the server.
APP_URL="https://eccare.in"

NODE_ENV="production"

# NOTE: in production on Hostinger, set these in the Node.js app's Environment
# Variables panel in hPanel — NOT as a .env file in the deployed directory. A .env
# file gets wiped by autodeploy's git sync. See ec-platform skill §7.2.

# WhatsApp Cloud API (Meta) — sign-in codes. Optional: the "sign in with a WhatsApp
# code" option stays hidden on the login page until both of the first two are set.
# WHATSAPP_OTP_TEMPLATE must be an approved AUTHENTICATION-category template with a
# "Copy code" button (default name below).
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE="ec_login_code"
WHATSAPP_OTP_TEMPLATE_LANG="en"
