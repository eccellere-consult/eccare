# Database (MySQL on Hostinger — separate ec_db)
# Use 127.0.0.1, NOT localhost (localhost resolves to IPv6 ::1, DB grant is IPv4-only)
DATABASE_URL="mysql://ec_user:password@127.0.0.1:3306/ec_db"

# Auth
JWT_SECRET="generate-a-strong-random-secret-here"

# Claude API (voice assistant) — optional, voice features degrade gracefully without it
ANTHROPIC_API_KEY="sk-ant-..."

# Firebase Cloud Messaging — optional, push notifications no-op without it
FCM_PROJECT_ID=""
FCM_PRIVATE_KEY=""
FCM_CLIENT_EMAIL=""

NODE_ENV="production"

# NOTE: in production on Hostinger, set these in the Node.js app's Environment
# Variables panel in hPanel — NOT as a .env file in the deployed directory. A .env
# file gets wiped by autodeploy's git sync. See ec-platform skill §7.2.
