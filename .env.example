# Database (MySQL on Hostinger — separate ec_db)
# Use 127.0.0.1, NOT localhost (localhost resolves to IPv6 ::1, DB grant is IPv4-only)
DATABASE_URL="mysql://ec_user:password@127.0.0.1:3306/ec_db"

# Auth
JWT_SECRET="generate-a-strong-random-secret-here"

# Claude API (voice assistant) — optional, voice features degrade gracefully without it
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI Whisper (speech-to-text for "Speak to Arya" and voice-based Health Notes) —
# without this, POST /api/v1/voice/transcribe returns a clear "not available" error
# instead of transcribing, so tap-to-speak silently can't turn a recording into text
# or an action. Get a key at platform.openai.com/api-keys.
OPENAI_API_KEY="sk-..."

# Cloudflare R2 (S3-compatible object storage) — required for every upload feature:
# Memories, Prescriptions, Health Coverage/Diagnostic Report documents, Community
# documents, Marketplace and Provider Catalog images, Provider certifications.
# Without these, POST to any of those routes returns a clear "not available" error
# instead of silently losing the file.
#
# Why object storage and not local disk: Hostinger's autodeploy checks every push
# out into a brand-new versioned build directory, so anything written to local disk
# (the old approach) was wiped on the very next deploy — this was the actual cause
# of "photo uploaded on mobile isn't visible on web (or vice versa)".
#
# Setup: create a bucket in the Cloudflare dashboard (R2 Object Storage → Create
# bucket), enable public access for it (Settings → allow the r2.dev public URL, or
# connect a custom domain), then create an API token (R2 → Manage R2 API Tokens →
# Create API Token, with read+write permission on this bucket) for the key pair below.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="eccare-uploads"
# No trailing slash — the r2.dev public URL shown on the bucket's Settings page
# (e.g. https://pub-xxxxxxxxxxxx.r2.dev), or a custom domain connected to it.
R2_PUBLIC_URL=""

# Firebase Cloud Messaging — optional, push notifications no-op without it
FCM_PROJECT_ID=""
FCM_PRIVATE_KEY=""
FCM_CLIENT_EMAIL=""

# Resend (password reset emails) — optional; forgot-password requests still succeed
# without it, but no email actually goes out (logged to server console instead).
# Get an API key at resend.com, verify eccare.in as a sending domain there, then set
# EMAIL_FROM to an address on that domain, e.g. "EC <no-reply@eccare.in>".
RESEND_API_KEY=""
EMAIL_FROM="EC <no-reply@eccare.in>"

# Public base URL used to build links in outgoing emails (e.g. password reset).
# Falls back to the request's own origin if unset, but set this explicitly in
# production so links are always https://eccare.in/... regardless of how the
# request reached the server.
APP_URL="https://eccare.in"

NODE_ENV="production"

# NOTE: in production on Hostinger, set these in the Node.js app's Environment
# Variables panel in hPanel — NOT as a .env file in the deployed directory. A .env
# file gets wiped by autodeploy's git sync. See ec-platform skill §7.2.
