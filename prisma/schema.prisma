generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  phone             String?  @unique
  email             String?  @unique
  passwordHash      String?
  name              String
  pinHash           String?
  avatarUrl         String?
  role              UserRole @default(elder)
  language          String   @default("en") // the elder's currently active display language
  secondaryLanguage String? // the elder's other language option; caregiver sets this pair together with `language`
  fontSizePref      String   @default("xlarge")
  highContrast      Boolean  @default(true)
  voiceEnabled      Boolean  @default(true)
  bloodGroup        String?
  address           String?  @db.Text
  city              String?
  state             String?
  pincode           String?
  lat               Decimal? @db.Decimal(10, 7)
  lng               Decimal? @db.Decimal(10, 7)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations as elder
  medications        Medication[]
  reminders          MedicationReminder[]
  appointments       Appointment[]
  healthNotes        HealthNote[]         @relation("HealthNoteUser")
  sosEvents          SOSEvent[]
  emergencyContacts  EmergencyContact[]
  foodRequests       FoodRequest[]
  mealReminders      MealReminder[]
  voiceLogs          VoiceLog[]
  deviceTokens       DeviceToken[]
  elderRelations     FamilyRelation[]     @relation("ElderRelations")
  caregiverRelations FamilyRelation[]     @relation("CaregiverRelations")
  healthNotesCreated HealthNote[]         @relation("HealthNoteCreator")
  sosAcknowledged    SOSEvent[]           @relation("SOSAcknowledger")
  foodHandled        FoodRequest[]        @relation("FoodHandler")
  prescriptions      Prescription[]       @relation("PrescriptionUser")
  prescriptionsUploaded Prescription[]    @relation("PrescriptionUploader")

  // Community
  memberships         NeighborhoodMember[]
  eventsCreated       CommunityEvent[]     @relation("EventCreator")
  eventRsvps          CommunityEventRsvp[]
  greetingsSent       Greeting[]           @relation("GreetingSender")
  greetingsReceived   Greeting[]           @relation("GreetingRecipient")
  listingsAdded       LocalListing[]       @relation("ListingCreator")
  queriesRaised       CommitteeQuery[]     @relation("QueryAuthor")
  queryReplies        CommitteeQueryReply[]
  noticesCreated      Notice[]             @relation("NoticeCreator")
  whatsAppGroupsAdded WhatsAppGroupLink[]  @relation("WhatsAppGroupCreator")
  chatMessages        ChatMessage[]
  notificationPrefs   NotificationPreference[]
  geriatricListings   GeriatricCareListing[]   @relation("GeriatricListingCreator")
  wellnessVideosAdded WellnessVideo[]

  // Service provider
  serviceProvider          ServiceProvider?  @relation("ServiceProviderUser")
  verifiedServiceProviders ServiceProvider[] @relation("ServiceProviderVerifier")

  // Personal contact book
  contactsOwned Contact[] @relation("ContactElder")
  contactsAdded Contact[] @relation("ContactAdder")

  // Memories (family-private photos)
  memoriesOwned Memory[] @relation("MemoryElder")
  memoriesAdded Memory[] @relation("MemoryAdder")

  // Orders (catalog checkout)
  ordersAsElder  Order[] @relation("OrderElder")
  ordersPlaced   Order[] @relation("OrderPlacer")

  // Password recovery
  passwordResetTokens PasswordResetToken[]

  // Voice-created informal reminders — distinct from `reminders` (MedicationReminder)
  voiceReminders Reminder[]

  // Residents' association fees
  communityFeesCreated CommunityFee[] @relation("CommunityFeeCreator")
  feeChargesOwed       FeeCharge[]    @relation("FeeChargeResident")
  feeChargesPaid       FeeCharge[]    @relation("FeeChargePayer")

  @@index([phone])
  @@index([role])
}

/** An informal, one-off reminder — "call the plumber at 5", "take a walk this
 *  evening" — distinct from Medication/MedicationReminder, which is specifically
 *  the medicine-schedule pill box. Created almost entirely via the voice assistant's
 *  set_reminder action; pull-based like everything else in this app (shown on the
 *  elder health page), not push-at-exact-time — nothing else here does scheduled
 *  push delivery either, so this doesn't introduce a new background-job dependency. */
model Reminder {
  id        String    @id @default(cuid())
  userId    String
  message   String
  remindAt  DateTime
  notified  Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

/** Platform-wide configuration a platform admin can edit — currently just the
 *  commission rate. Deliberately a singleton (one row, id always "singleton") rather
 *  than a generic key-value settings table — there's exactly one setting today, and
 *  a real column with a real type beats a stringly-typed key/value row for the one
 *  thing that actually needs editing. Add more typed columns here if more settings
 *  show up before this ever needs to become a real table-per-setting design. */
model PlatformSettings {
  id                String   @id @default("singleton")
  // Commission EC takes on both provider-service orders and community fee
  // payments — see Order.platformFeeAmount / FeeCharge.platformFeeAmount. No real
  // Razorpay split-payment (Route) integration exists — every payment still lands
  // 100% in EC's own Razorpay account; this rate is recorded on each transaction
  // for accounting so vendors/associations can be settled manually outside the
  // app. Snapshotted onto each paid Order/FeeCharge at payment time, not looked up
  // live, so changing this later never rewrites the commission on past transactions.
  platformFeePercent Decimal @default(5) @db.Decimal(5, 2)
  // Flat monthly fee a verified provider pays (via Razorpay) to be featured at the
  // top of /services/elder-care for 30 days — see ServiceProvider.isFeatured.
  elderCareAdPricePerMonth Decimal @default(499) @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt
  updatedById       String?
}

/** A single-use, short-lived token emailed to a user to let them reset their
 *  password without knowing the old one. Only the SHA-256 hash of the raw token is
 *  stored — same reasoning as `User.pinHash`: a DB leak alone should never be enough
 *  to reset someone's password. The raw token only ever exists in the emailed link. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  elder
  caregiver
  admin
  provider
}

model FamilyRelation {
  id               String       @id @default(cuid())
  elderUserId      String
  caregiverUserId  String
  relationship     String
  canViewHealth    Boolean      @default(true)
  canManageMeds    Boolean      @default(true)
  receivesSos      Boolean      @default(true)
  receivesCheckin  Boolean      @default(true)
  inviteStatus     InviteStatus @default(pending)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  elderUser     User @relation("ElderRelations", fields: [elderUserId], references: [id], onDelete: Cascade)
  caregiverUser User @relation("CaregiverRelations", fields: [caregiverUserId], references: [id], onDelete: Cascade)

  @@unique([elderUserId, caregiverUserId])
}

enum InviteStatus {
  pending
  accepted
  declined
}

model EmergencyContact {
  id           String  @id @default(cuid())
  userId       String
  name         String
  phone        String
  relationship String
  callOrder    Int     @default(1)
  notifyOnSos  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// General categorized contact book (neighbor, friend, service provider, hospital,
/// etc.) — distinct from EmergencyContact, which is specifically the SOS-notify list.
/// "Emergency Contact" as a category routes into EmergencyContact directly instead of
/// creating a row here, so there is no duplicate/parallel record for it.
model Contact {
  id              String          @id @default(cuid())
  elderUserId     String
  addedById       String
  name            String
  phone           String
  category        ContactCategory
  providerType    String? // sub-type when category = serviceProvider (e.g. "Plumber")
  notes           String?         @db.Text
  sharedListingId String?         @unique // set when promoted to the community Vendors directory
  // Opt-in flag for category = neighbor: shows this contact (name + phone) in the
  // community's "Your neighbours" directory alongside registered members. No separate
  // promoted record the way Vendors sharing gets one — a phone-book entry visible only
  // to fellow members of the elder's own community is low-stakes enough not to need
  // committee/admin verification.
  shareWithNeighbours Boolean      @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  elderUser     User          @relation("ContactElder", fields: [elderUserId], references: [id], onDelete: Cascade)
  addedBy       User          @relation("ContactAdder", fields: [addedById], references: [id], onDelete: Cascade)
  sharedListing LocalListing? @relation(fields: [sharedListingId], references: [id], onDelete: SetNull)

  @@index([elderUserId])
}

enum ContactCategory {
  neighbor
  friend
  serviceProvider
  hospital
  other
}

/// A private photo shared within one elder's own family — distinct from the
/// community-scoped, social Photo Album backlog item (Community Buzz), which is
/// neighbourhood-wide. Same elderUserId/addedById split as Contact and Order —
/// gated by canAccessElder, never visible outside that elder's linked family.
model Memory {
  id          String   @id @default(cuid())
  elderUserId String
  addedById   String
  imagePath   String
  caption     String?  @db.Text
  createdAt   DateTime @default(now())

  elderUser User @relation("MemoryElder", fields: [elderUserId], references: [id], onDelete: Cascade)
  addedBy   User @relation("MemoryAdder", fields: [addedById], references: [id], onDelete: Cascade)

  @@index([elderUserId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Health & Medicine ──────────────────────────────────────────

model Medication {
  id               String   @id @default(cuid())
  userId           String
  prescriptionId   String?
  name             String
  dosage           String
  frequency        String
  timeSlots        Json
  instructions     String?  @db.Text
  prescribingDoctor String?
  // Doctor-recommended course end date, when known — e.g. a 5-day antibiotic course.
  // Null means indefinite/ongoing, which is the common case for elder medication
  // (BP, diabetes, etc. are typically lifelong) — reminders keep generating until
  // this date passes, or the caregiver deletes/deactivates it, whichever comes first.
  // The record itself is never auto-deleted or hidden when this passes; only new
  // reminder generation stops.
  endDate          DateTime?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescription Prescription?        @relation("PrescriptionMeds", fields: [prescriptionId], references: [id], onDelete: SetNull)
  reminders    MedicationReminder[]

  @@index([userId, isActive])
}

model MedicationReminder {
  id           String         @id @default(cuid())
  medicationId String
  userId       String
  scheduledAt  DateTime
  status       ReminderStatus @default(pending)
  takenAt      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
}

enum ReminderStatus {
  pending
  taken
  missed
  snoozed
}

model Appointment {
  id         String            @id @default(cuid())
  userId     String
  doctorName String
  hospital   String?
  specialty  String?
  datetime   DateTime
  notes      String?           @db.Text
  status     AppointmentStatus @default(upcoming)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, datetime])
}

enum AppointmentStatus {
  upcoming
  completed
  cancelled
}

model HealthNote {
  id          String   @id @default(cuid())
  userId      String
  createdById String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  user      User @relation("HealthNoteUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("HealthNoteCreator", fields: [createdById], references: [id], onDelete: Cascade)
}

model Prescription {
  id              String   @id @default(cuid())
  userId          String
  uploadedById    String
  fileName        String
  filePath        String
  fileType        String
  extractedData   Json?
  doctorName      String?
  hospitalName    String?
  prescriptionDate DateTime?
  notes           String?  @db.Text
  reviewed        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User         @relation("PrescriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation("PrescriptionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  medications Medication[] @relation("PrescriptionMeds")

  @@index([userId, createdAt])
}

model DailyQuote {
  id          String           @id @default(cuid())
  text        String           @db.Text
  author      String?
  status      DailyQuoteStatus @default(pending)
  generatedBy String?
  usedOn      DateTime?        @db.Date
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, usedOn])
}

enum DailyQuoteStatus {
  pending
  approved
  rejected
}

/// Admin-curated yoga/exercise/meditation content — a link to a YouTube video, not
/// hosted content. Elder-facing, admin-managed, same shape as DailyQuote's
/// admin-CRUD-then-public-read pattern.
model WellnessVideo {
  id          String            @id @default(cuid())
  title       String
  category    WellnessCategory
  youtubeUrl  String
  description String?           @db.Text
  isActive    Boolean           @default(true)
  addedById   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  addedBy User @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@index([isActive, category])
}

enum WellnessCategory {
  yoga
  exercise
  meditation
}

// ─── Emergency & Safety ─────────────────────────────────────────

model SOSEvent {
  id             String    @id @default(cuid())
  userId         String
  triggerType    String
  lat            Decimal?  @db.Decimal(10, 7)
  lng            Decimal?  @db.Decimal(10, 7)
  address        String?   @db.Text
  status         String    @default("triggered")
  acknowledgedBy String?
  // Set when the alert was raised as a community panic alert, so the neighbourhood's
  // committee/security can see it too. Deliberately an optional field on the existing
  // model rather than a parallel PanicAlert table — one emergency table keeps the
  // admin SOS feed and any "was help sent?" audit complete by construction.
  neighborhoodId String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledger User?         @relation("SOSAcknowledger", fields: [acknowledgedBy], references: [id])
  neighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([neighborhoodId, status])
}

// ─── Food ───────────────────────────────────────────────────────

model FoodRequest {
  id          String   @id @default(cuid())
  userId      String
  requestType String
  notes       String?  @db.Text
  status      String   @default("requested")
  handledBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  handler User? @relation("FoodHandler", fields: [handledBy], references: [id])
}

model MealReminder {
  id       String  @id @default(cuid())
  userId   String
  mealType String
  time     String
  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Voice ──────────────────────────────────────────────────────

model VoiceLog {
  id           String   @id @default(cuid())
  userId       String
  transcript   String   @db.Text
  intent       String
  responseText String   @db.Text
  actionTaken  String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Admin: Backlog / Kanban ─────────────────────────────────────

model BacklogItem {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  status      BacklogStatus   @default(backlog)
  priority    BacklogPriority @default(medium)
  position    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, position])
}

enum BacklogStatus {
  backlog
  todo
  in_progress
  review
  done
}

enum BacklogPriority {
  low
  medium
  high
}

// ─── Community (Phase 1) ─────────────────────────────────────────
// Modelled on Adda.io / MyGate. Everything here is scoped to a Neighborhood — there
// are no open/global social surfaces, which keeps moderation tractable for what is
// fundamentally an elder-safety product.

model Neighborhood {
  id          String   @id @default(cuid())
  name        String
  city        String?
  pincode     String?
  description String?  @db.Text
  // Short human-shareable code so a resident can join without an admin doing manual
  // linking for every household.
  joinCode    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        NeighborhoodMember[]
  events         CommunityEvent[]
  greetings      Greeting[]
  helplines      CommunityHelpline[]
  listings       LocalListing[]
  queries        CommitteeQuery[]
  notices        Notice[]
  whatsAppGroups WhatsAppGroupLink[]
  messages       ChatMessage[]
  fees           CommunityFee[]
  sosEvents      SOSEvent[]
  providerListings CommunityProviderListing[]

  @@index([pincode])
}

enum NeighborhoodRole {
  member
  committee
  admin
}

model NeighborhoodMember {
  id              String           @id @default(cuid())
  neighborhoodId  String
  userId          String
  role            NeighborhoodRole @default(member)
  flatNumber      String?
  // Residents can stay in the community but keep themselves out of the public
  // directory — a privacy affordance both reference apps get wrong by default.
  showInDirectory Boolean          @default(true)
  createdAt       DateTime         @default(now())

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeCharges   FeeCharge[]

  @@unique([neighborhoodId, userId])
  @@index([neighborhoodId, role])
}

/// A recurring or one-time fee the management committee/admin defines for their
/// community — e.g. "Monthly Maintenance" at a flat rate per flat. Generating
/// charges for a billing cycle (see FeeCharge) is a deliberate committee action,
/// not automatic — this app has no background-job/cron infrastructure anywhere
/// else either, and billing residents is exactly the kind of thing that shouldn't
/// silently happen without someone actually deciding to run it this month.
model CommunityFee {
  id             String       @id @default(cuid())
  neighborhoodId String
  label          String
  defaultAmount  Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency @default(monthly)
  // Stops future charge generation without deleting the fee definition or its
  // billing history — same soft-off pattern as WellnessVideo.isActive.
  isActive       Boolean      @default(true)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CommunityFeeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  charges      FeeCharge[]

  @@index([neighborhoodId])
}

enum FeeFrequency {
  monthly
  one_time
}

/// One actual bill issued to one flat/resident for one billing period — generated
/// from a CommunityFee, one row per (fee, member, period). The unique constraint
/// below is what makes "generate this month's charges" safe to click twice: a
/// period already billed is simply skipped, never double-charged.
model FeeCharge {
  id                  String          @id @default(cuid())
  communityFeeId      String
  neighborhoodMemberId String
  // Denormalized from NeighborhoodMember.userId at generation time — same reasoning
  // as Order.elderUserId: lets payment access control (canAccessElder) and the
  // resident's own "what do I owe" query work without an extra join, and survives
  // the member later leaving the community (their past bills don't vanish).
  residentUserId      String
  // "2026-08" for a monthly cycle, "one-time" for a one_time fee — see the unique
  // constraint below.
  period              String
  // Snapshotted from CommunityFee.defaultAmount when this charge was generated —
  // editable afterward (per-flat override) while still unpaid, but a later change
  // to the fee's own default never rewrites bills already issued.
  amount              Decimal         @db.Decimal(10, 2)
  dueDate             DateTime
  status              FeeChargeStatus @default(due)
  razorpayOrderId     String?         @unique
  razorpayPaymentId   String?
  paidAt              DateTime?
  paidByUserId        String?
  // Same platform-fee snapshot pattern as Order — see lib/platform-settings.ts.
  platformFeeAmount       Decimal?    @db.Decimal(10, 2)
  netAmountForAssociation Decimal?    @db.Decimal(10, 2)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  communityFee       CommunityFee       @relation(fields: [communityFeeId], references: [id], onDelete: Cascade)
  neighborhoodMember NeighborhoodMember @relation(fields: [neighborhoodMemberId], references: [id], onDelete: Cascade)
  resident           User               @relation("FeeChargeResident", fields: [residentUserId], references: [id], onDelete: Cascade)
  paidBy             User?              @relation("FeeChargePayer", fields: [paidByUserId], references: [id])

  @@unique([communityFeeId, neighborhoodMemberId, period])
  @@index([residentUserId])
  @@index([neighborhoodMemberId])
}

enum FeeChargeStatus {
  due
  paid
  waived
}

model CommunityEvent {
  id             String   @id @default(cuid())
  neighborhoodId String
  title          String
  description    String?  @db.Text
  location       String?
  startsAt       DateTime
  endsAt         DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  neighborhood Neighborhood         @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  rsvps        CommunityEventRsvp[]

  @@index([neighborhoodId, startsAt])
}

enum RsvpStatus {
  going
  maybe
  not_going
}

model CommunityEventRsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus @default(going)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

/// "Drop a hello" — a deliberately tiny, low-pressure icebreaker between neighbours.
model Greeting {
  id             String   @id @default(cuid())
  neighborhoodId String
  fromUserId     String
  toUserId       String
  message        String?  @db.Text
  readAt         DateTime?
  createdAt      DateTime @default(now())

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("GreetingSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User         @relation("GreetingRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, createdAt])
}

/// Shared community helpline numbers (security gate, police, fire, ambulance).
/// Distinct from the per-user EmergencyContact model, which is personal to an elder.
model CommunityHelpline {
  id             String   @id @default(cuid())
  neighborhoodId String
  label          String
  phone          String
  category       String   @default("general")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId, sortOrder])
}

/// Vendors / local services directory. neighborhoodId is nullable so a listing can be
/// area-wide rather than tied to one society.
model LocalListing {
  id             String   @id @default(cuid())
  neighborhoodId String?
  name           String
  category       String
  phone          String
  address        String?  @db.Text
  description    String?  @db.Text
  addedById      String
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  neighborhood     Neighborhood?              @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  addedBy          User                       @relation("ListingCreator", fields: [addedById], references: [id], onDelete: Cascade)
  sharedFrom       Contact?
  providerListing  CommunityProviderListing?

  @@index([neighborhoodId, category])
}

enum QueryType {
  committee
  helpdesk
}

enum QueryStatus {
  open
  in_progress
  resolved
  closed
}

/// One ticket system serving two entry points: queries raised to the management
/// committee, and general help-desk requests. Distinguished by `type` rather than
/// duplicated into two near-identical models.
model CommitteeQuery {
  id             String      @id @default(cuid())
  neighborhoodId String
  userId         String
  type           QueryType   @default(committee)
  subject        String
  body           String      @db.Text
  status         QueryStatus @default(open)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  neighborhood Neighborhood          @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  user         User                  @relation("QueryAuthor", fields: [userId], references: [id], onDelete: Cascade)
  replies      CommitteeQueryReply[]

  @@index([neighborhoodId, status])
}

model CommitteeQueryReply {
  id        String   @id @default(cuid())
  queryId   String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  query CommitteeQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([queryId, createdAt])
}

/// Announcements from the committee to the whole neighbourhood.
model Notice {
  id             String   @id @default(cuid())
  neighborhoodId String
  title          String
  body           String   @db.Text
  pinned         Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([neighborhoodId, pinned, createdAt])
}

/// Curated directory of community WhatsApp group invite links. Deliberately a link-out
/// list, not an attempt to reimplement group messaging.
model WhatsAppGroupLink {
  id             String   @id @default(cuid())
  neighborhoodId String
  name           String
  description    String?  @db.Text
  inviteUrl      String   @db.Text
  createdById    String
  createdAt      DateTime @default(now())

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("WhatsAppGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([neighborhoodId])
}

/// Community Buzz — chat scoped per-neighbourhood, never open DMs.
model ChatMessage {
  id             String   @id @default(cuid())
  neighborhoodId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([neighborhoodId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String
  push      Boolean  @default(true)
  email     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// ─── Geriatrics Care Directory ──────────────────────────────────

enum GeriatricCareCategory {
  self_help_group
  ngo
  palliative_care
  physiotherapy
  massage
  yoga
  meditation
}

model GeriatricCareListing {
  id          String                @id @default(cuid())
  name        String
  category    GeriatricCareCategory
  description String?               @db.Text
  phone       String?
  email       String?
  website     String?
  address     String?               @db.Text
  city        String?
  pincode     String?
  contactName String?
  isActive    Boolean               @default(true)
  verified    Boolean               @default(false)
  addedById   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  addedBy User @relation("GeriatricListingCreator", fields: [addedById], references: [id], onDelete: Cascade)

  @@index([category, isActive])
  @@index([city])
}

// ─── Service Provider ───────────────────────────────────────────

enum ProviderVerificationStatus {
  pending
  verified
  rejected
}

model ServiceProvider {
  id                    String                     @id @default(cuid())
  userId                String                     @unique
  businessName          String
  category              String
  description           String?                    @db.Text
  serviceArea           String?
  phone                 String?
  address               String?                    @db.Text
  certificationFileName String?
  certificationFilePath String?
  verificationStatus    ProviderVerificationStatus @default(pending)
  rejectionReason       String?
  verifiedAt            DateTime?
  verifiedById          String?
  // Elder Care Services directory — a verified provider self-tags into one of these
  // to appear on /services/elder-care. Null means "not offering elder-care services",
  // not "unknown" — most providers (grocers, electricians) legitimately have none.
  elderCareCategory     ElderCareCategory?
  // Paid advertisement: a flat monthly fee (PlatformSettings.elderCareAdPricePerMonth)
  // bumps this provider to the top of the elder-care directory with a "Featured"
  // badge for 30 days. This is EC's own ad revenue — no platform-fee split applies,
  // unlike Order/FeeCharge which are payments passing through to a vendor/association.
  isFeatured            Boolean                    @default(false)
  featuredUntil         DateTime?
  featuredOrderId       String?                    @unique
  featuredPaidAt        DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  user       User  @relation("ServiceProviderUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("ServiceProviderVerifier", fields: [verifiedById], references: [id])
  communityListings CommunityProviderListing[]
  catalogItems       CatalogItem[]
  orders             Order[]

  @@index([verificationStatus])
  @@index([elderCareCategory])
}

enum ElderCareCategory {
  home_treatment
  home_nursing
  companion_service
  local_errands
  other
}

/// Connects a registered ServiceProvider to one community's Vendors directory.
/// Dual-approval, in order: the community's own committee/admin vouches first
/// (communityApproved), then the platform admin gives final sign-off (approved) —
/// only then is a verified LocalListing auto-created and linked.
model CommunityProviderListing {
  id                    String    @id @default(cuid())
  providerId            String
  neighborhoodId        String
  status                CPLStatus @default(pending)
  communityApprovedAt   DateTime?
  communityApprovedById String?
  platformApprovedAt    DateTime?
  platformApprovedById  String?
  rejectedAt            DateTime?
  rejectedById          String?
  rejectionReason       String?
  localListingId        String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  provider     ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  neighborhood Neighborhood    @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  localListing LocalListing?   @relation(fields: [localListingId], references: [id], onDelete: SetNull)

  @@unique([providerId, neighborhoodId])
}

enum CPLStatus {
  pending
  communityApproved
  approved
  rejected
}

/// A provider's browsable products/services — name, price, photo. Elders and family
/// browse these from a community's Vendors detail page and check out per-provider.
model CatalogItem {
  id          String   @id @default(cuid())
  providerId  String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  imagePath   String?
  category    String?
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([providerId])
}

/// elderUserId is whose household the order is for; placedByUserId is who actually
/// checked out (elder or caregiver) — same split as Contact's elderUserId/addedById.
/// Checkout is deliberately per-provider, not a multi-vendor cart.
model Order {
  id                String      @id @default(cuid())
  elderUserId       String
  placedByUserId    String
  providerId        String
  status            OrderStatus @default(pending)
  totalAmount       Decimal     @db.Decimal(10, 2)
  deliveryAddress   String      @db.Text
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  paidAt            DateTime?
  // Snapshotted from PlatformSettings.platformFeePercent at the moment payment is
  // verified — see lib/platform-settings.ts. Null until paid; a rate change later
  // never rewrites what a past order actually recorded.
  platformFeeAmount      Decimal?     @db.Decimal(10, 2)
  netAmountForProvider   Decimal?     @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  elderUser User            @relation("OrderElder", fields: [elderUserId], references: [id], onDelete: Cascade)
  placedBy  User            @relation("OrderPlacer", fields: [placedByUserId], references: [id], onDelete: Cascade)
  provider  ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([elderUserId])
  @@index([providerId])
}

/// name/price are snapshotted at order time — survives the catalog item being edited
/// or deleted afterward, so past orders always show what was actually bought.
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  catalogItemId String?
  name          String
  price         Decimal @db.Decimal(10, 2)
  quantity      Int

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
}

enum OrderStatus {
  pending
  paid
  confirmed
  cancelled
}
